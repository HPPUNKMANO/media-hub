# Copy this file to ".env" and fill in the blanks. ".env" holds secrets: never share it.

# ---- Paths (forward slashes; keep both OUTSIDE OneDrive)
MEDIA_DIR=C:/Media
SERVER_DIR=C:/MediaServer
TZ=Europe/Paris

# ---- Organizer
# dry-run = only report what it would do (start here!) | live = actually move files | off = manual runs only
ORGANIZER_MODE=dry-run
ORGANIZER_INTERVAL_MINUTES=10
# a file must be unchanged for this many seconds before it is touched (avoids half-copied files)
ORGANIZER_STABLE_SECONDS=120
ORGANIZER_FETCH_COVER_ART=true
# Free key: https://www.themoviedb.org/settings/api  (the "API Key" or the "API Read Access Token" both work)
TMDB_API_KEY=
METADATA_LANGUAGE=en-US

# ---- Jellyfin (Dashboard > API Keys > +)
JELLYFIN_API_KEY=
# your Jellyfin user name, used for "Continue watching" on the Hub
JELLYFIN_USER=
# optional: what Jellyfin advertises to apps, e.g. http://192.168.1.20:8096
PUBLISHED_URL_JELLYFIN=

# ---- Navidrome (the user you created on first login)
NAVIDROME_USER=
NAVIDROME_PASSWORD=
ND_LASTFM_ENABLED=false

# ---- Audiobookshelf (Settings > Users > your user > API token)
ABS_API_TOKEN=

# ---- Phone access: address of this PC on your Wi-Fi (shown as a QR code on the hub's Install app page)
HUB_LAN_URL=
